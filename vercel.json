{
  "rewrites": [
    { "source": "/api/:path((?!unsplash(?:/|$)).*)", "destination": "https://shoppinglist-xbdp.onrender.com/:path*" },
    { "source": "/:path((?!api(?:/|$)).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    }
  ]
}
